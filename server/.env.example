# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# Your deployed server URL (e.g. https://nexora-pos.railway.app)
# Flutterwave will redirect card payments here, so it must be public HTTPS
SERVER_URL=https://your-server.railway.app

# ── Flutterwave ───────────────────────────────────────────────────────────────
# Get these from https://dashboard.flutterwave.com → Settings → API Keys
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# Set this in Flutterwave dashboard → Settings → Webhooks → "Secret hash"
# Use any strong random string, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FLW_WEBHOOK_HASH=your-webhook-secret-hash

# ── Subscription ──────────────────────────────────────────────────────────────
SUBSCRIPTION_AMOUNT=600
SUBSCRIPTION_DAYS=30

# ── Admin ─────────────────────────────────────────────────────────────────────
# Used to manually activate bank-transfer subscriptions via POST /api/admin/activate
# Generate a strong random string
ADMIN_KEY=change-this-to-a-strong-random-key
