{
  "expo": {
    "name": "Nexora POS",
    "slug": "nexora-pos",
    "scheme": "nexorapos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1db8a0"
      },
      "package": "com.nexora.pos",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      "expo-font",
      "expo-status-bar",
      "expo-dev-client",
      "expo-image-picker",
      [
        "react-native-thermal-printer",
        {
          "bluetoothPermission": "Allow Nexora POS to connect to your receipt printer via Bluetooth.",
          "usbPermission": "Allow Nexora POS to connect to your receipt printer via USB."
        }
      ],
      [
        "expo-camera",
        { "cameraPermission": "Allow Nexora POS to access camera for barcode scanning and product photos." }
      ],
      [
        "react-native-purchases",
        { "androidApiKey": "REVENUECAT_ANDROID_API_KEY" }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "rcApiKey": "REVENUECAT_ANDROID_API_KEY",
      "subscriptionProductId": "nexora_pos_monthly"
    }
  }
}
